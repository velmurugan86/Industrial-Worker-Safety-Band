# ============================================================
# WorkBand Backend - Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your setup.
# All values here override defaults in main.py.
# ============================================================

# --- Server ---
PORT=8001
HOST=0.0.0.0

# --- SQLite Relational Database ---
SAFETY_DB_PATH=safety_band.db
DEVICE_STALE_SECONDS=15

# --- MQTT Broker (Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- InfluxDB Time-Series Database (Optional) ---
# The backend will automatically degrade to SQLite if InfluxDB is not running.
INFLUX_URL=http://localhost:8086
# Replace with your InfluxDB API token generated from InfluxDB Web UI (Data -> API Tokens)
INFLUX_TOKEN=YOUR_INFLUXDB_API_TOKEN_HERE
INFLUX_ORG=your-organization-name
INFLUX_BUCKET=safety_telemetry

# --- Physiological Alert Thresholds ---
HEART_MIN=45
HEART_MAX=130
SPO2_MIN=90
TEMP_MAX=38
